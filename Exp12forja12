    text = text.replace(" [title]", ". ")
    text = text.replace("  ", " ")
    return text
def _procesar(doc, desplazamiento):
    # Mismo contenido y orden inicial que el GPQA original,
    # pero con una semilla estable por pregunta.
    choices = [
        preprocess(doc["Incorrect Answer 1"]),
        preprocess(doc["Incorrect Answer 2"]),
        preprocess(doc["Incorrect Answer 3"]),
        preprocess(doc["Correct Answer"]),
    ]
    semilla = int.from_bytes(
        hashlib.sha256(doc["Question"].encode("utf-8")).digest()[:8],
        "big",
    )
    random.Random(semilla).shuffle(choices)
    # Desplazamiento circular hacia la derecha.
