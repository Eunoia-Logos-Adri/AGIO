    if desplazamiento:
        choices = choices[-desplazamiento:] + choices[:-desplazamiento]
    correcta = preprocess(doc["Correct Answer"])
    indice = choices.index(correcta)
    return {
        "choice1": choices[0],
        "choice2": choices[1],
        "choice3": choices[2],
        "choice4": choices[3],
        "answer": f"({chr(65 + indice)})",
